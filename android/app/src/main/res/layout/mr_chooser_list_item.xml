<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="32dp"
    android:paddingLeft="@dimen/mediarouter_chooser_list_item_padding_start"
    android:paddingRight="@dimen/mediarouter_chooser_list_item_padding_end"
    android:paddingStart="@dimen/mediarouter_chooser_list_item_padding_start"
    android:paddingEnd="@dimen/mediarouter_chooser_list_item_padding_end"
    android:paddingTop="@dimen/mediarouter_chooser_list_item_padding_top"
    android:paddingBottom="@dimen/mediarouter_chooser_list_item_padding_bottom"
    android:orientation="horizontal"
    android:gravity="center_vertical">

    <ImageView
        android:id="@+id/mr_chooser_route_icon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginEnd="24dp" />

    <ProgressBar
        android:id="@+id/mr_chooser_route_progress_bar"
        style="?android:attr/progressBarStyle"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginEnd="24dp"
        android:indeterminate="true"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="1dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/mr_chooser_route_name"
            android:layout_width="match_parent"
            android:layout_height="28dp"
            android:ellipsize="marquee"
            android:gravity="start"
            android:singleLine="true"
            android:textAlignment="viewStart"
            android:textAppearance="@style/TextAppearance.MediaRouter.PrimaryText" />

        <TextView
            android:id="@+id/mr_chooser_route_desc"
            android:layout_width="match_parent"
            android:layout_height="20dp"
            android:ellipsize="marquee"
            android:gravity="start"
            android:singleLine="true"
            android:textAlignment="viewStart"
            android:textAppearance="@style/TextAppearance.MediaRouter.SecondaryText" />
    </LinearLayout>
</LinearLayout>
