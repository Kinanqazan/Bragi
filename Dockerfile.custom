FROM alpine:3.20 AS final
LABEL org.opencontainers.image.title="Bragi"
LABEL org.opencontainers.image.description="Self-hosted music streaming server and web app"
LABEL org.opencontainers.image.source="https://github.com/Kinanqaz/Bragi"

# Install runtime dependencies
# - libwebp + symlinks: enables native WebP encoding via purego/dlopen
RUN apk add -U --no-cache ffmpeg mpv sqlite libwebp libwebpdemux libwebpmux && \
    for lib in libwebp libwebpdemux libwebpmux; do \
        target=$(ls /usr/lib/$lib.so.* 2>/dev/null | head -1) && \
        [ -n "$target" ] && ln -sf "$target" /usr/lib/$lib.so; \
    done

# Copy Bragi binary (prebuilt dynamic musl binary for Alpine)
COPY out/navidrome /app/navidrome

VOLUME ["/data", "/music"]
ENV BR_MUSICFOLDER=/music
ENV BR_DATAFOLDER=/data
ENV BR_CONFIGFILE=/data/navidrome.toml
ENV BR_PORT=4533
RUN touch /.nddockerenv

EXPOSE ${BR_PORT}
WORKDIR /app
ENV PATH="/app:${PATH}"

ENTRYPOINT ["/app/navidrome"]
